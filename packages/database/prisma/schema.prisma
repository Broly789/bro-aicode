datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model Session {
  id        String    @id @default(uuid())
  modelId   String    @default("deepseek-v4-flash")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id        String   @id
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String?
  parts     Json
  model     String?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}
