{
  "name": "brocode",
  "private": true,
  "packageManager": "bun",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --filter @brocode/server dev",
    "dev:cli": "PROJECT_ROOT=$PWD bun run --cwd \"$PWD/apps/cli\" dev",
    "dev:debug": "bun run --cwd \"$PWD/apps/cli\" dev 2> debug.log",
    "dev": "bun run dev:server & bun run dev:cli",
    "build:cli": "bun run --cwd \"$PWD/apps/cli\" build",
    "build": "bun run build:cli",
    "db:generate": "bun run --cwd \"$PWD/packages/database\" db:generate",
    "db:push": "bun run --cwd \"$PWD/packages/database\" db:push",
    "db:migrate": "bun run --cwd \"$PWD/packages/database\" db:migrate",
    "db:deploy": "bun run --cwd \"$PWD/packages/database\" db:deploy",
    "db:studio": "bun run --cwd \"$PWD/packages/database\" db:studio",
    "db:validate": "bun run --cwd \"$PWD/packages/database\" db:validate"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.1",
    "@types/node": "^26.0.1",
    "ai": "^7.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}