# Prisma Postgres — Server runtime connection string
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# DeepSeek API key — used by server for AI chat
DEEPSEEK_API_KEY="sk-..."

# Tavily API key — used by search tool for web search (free tier: 1000 req/month)
# Get yours at https://tavily.com
TAVILY_API_KEY="tvly-..."

# Baidu AI Search API key — used by search tool for Chinese content (free tier: 1500 req/month)
# Get yours at https://console.bce.baidu.com/qianfan/ais/console/onlineService
# Format: bce-v3/...
BAIDU_API_KEY=""

# Server
PORT=3000
