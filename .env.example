# Prisma Postgres — Server runtime connection string
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# ── Model Provider Keys ──────────────────────────────────────────────────────
# All app keys use BROCODE_ prefix to avoid inheriting shell-level variables
# (e.g. ANTHROPIC_API_KEY / OPENAI_BASE_URL used by Copilot / other tools).

# DeepSeek (default model)
# Get yours at https://platform.deepseek.com/
BROCODE_DEEPSEEK_API_KEY="sk-..."

# Alibaba Qwen
# Get yours at https://dashscope.console.aliyun.com/
BROCODE_ALIBABA_API_KEY="sk-..."
# Qwen base URL override (optional — defaults to DashScope compatible endpoint)
BROCODE_QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# OpenAI (GPT-4o, o3, o4-mini, etc.)
# Get yours at https://platform.openai.com/api-keys
BROCODE_OPENAI_API_KEY="sk-..."
# OpenAI base URL override (optional — defaults to https://api.openai.com/v1)
# BROCODE_OPENAI_BASE_URL=""

# Anthropic Claude (Claude Opus 4, Sonnet 4, 3.5 Sonnet, etc.)
# Get yours at https://console.anthropic.com/settings/keys
BROCODE_ANTHROPIC_API_KEY="sk-ant-..."
# Anthropic base URL override (optional — defaults to https://api.anthropic.com)
# BROCODE_ANTHROPIC_BASE_URL=""

# ── Default Model ─────────────────────────────────────────────────────────────
# Must match an id from the @brocode/ai model registry
AI_MODEL="deepseek-v4-flash"

# ── Search ────────────────────────────────────────────────────────────────────
# Tavily API key — used by search tool for web search (free tier: 1000 req/month)
# Get yours at https://tavily.com
TAVILY_API_KEY="tvly-..."

# Baidu AI Search API key — used by search tool for Chinese content (free tier: 1500 req/month)
# Get yours at https://console.bce.baidu.com/qianfan/ais/console/onlineService
# Format: bce-v3/...
BAIDU_API_KEY=""

# SEARCH_PRIORITY: tavily | baidu | (留空=智能路由: 中文→百度, 英文→Tavily)
SEARCH_PRIORITY=
# SEARCH_LOG: true 开启搜索日志, false 或留空关闭
SEARCH_LOG=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
